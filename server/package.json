{
  "name": "@musematch/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "db:generate": "tsx scripts/prisma.ts generate",
    "db:migrate": "tsx scripts/prisma.ts migrate dev",
    "db:deploy": "tsx scripts/prisma.ts migrate deploy",
    "db:push": "tsx scripts/prisma.ts db push",
    "db:studio": "tsx scripts/prisma.ts studio",
    "db:seed": "tsx prisma/seed.ts",
    "embeddings:backfill": "tsx src/scripts/backfillEmbeddings.ts",
    "eval:recommendations": "tsx src/scripts/evaluateRecommendations.ts",
    "db:reset": "tsx scripts/prisma.ts migrate reset",
    "db:reclassify": "tsx src/scripts/reclassify.ts",
    "verify:e2e": "tsx src/scripts/verifyEndToEnd.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@musematch/shared": "*",
    "@prisma/client": "^6.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^8.57.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
