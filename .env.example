# ---------------------------------------------------------------------------
# MuseMatch environment
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Server ---
NODE_ENV=development
PORT=4000
# `info` logs one line per request. Use `debug` to also see recommendation
# scoring, museum provider failures and embedding activity.
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Local Postgres started by `npm run db:up` (image includes pgvector).
DATABASE_URL=postgresql://musematch:musematch@localhost:5433/musematch?schema=public
# To use the Supabase Postgres instead, take the connection string from
# Project Settings -> Database and paste it here.

# --- Identity (Supabase Auth) ---
SUPABASE_URL=https://your-project.supabase.co
# Setting the JWT secret enables local HS256 verification (no network call per
# request). Leave blank to verify against the project's remote JWKS instead.
SUPABASE_JWT_SECRET=

# Development only: accept an `x-dev-user` header in place of a real token so
# the app can be run against seed data without a Supabase project. Refused if
# NODE_ENV=production.
DEV_AUTH_BYPASS=false

# --- Embeddings ---
# Omit OPENAI_API_KEY to fall back to the deterministic local provider, which
# keeps semantic search working offline (less well, but really working).
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- Museum providers ---
MET_API_BASE_URL=https://collectionapi.metmuseum.org/public/collection/v1
AIC_API_BASE_URL=https://api.artic.edu/api/v1
MUSEUM_REQUEST_TIMEOUT_MS=8000
MUSEUM_USER_AGENT=MuseMatch/0.1 (educational project)

# --- Client (Vite) ---
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Mirrors DEV_AUTH_BYPASS on the client so the UI skips the Supabase session.
VITE_DEV_AUTH_BYPASS=false
